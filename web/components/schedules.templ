package components

templ SchedulesPage(tenantName string, user UserView, rooms []BoardroomCardView, schedules []ScheduleView, csrfToken, formError, template string) {
	@Layout("Schedules", tenantName, &user, csrfToken) {
		<section class="hero hero-compact">
			<div><p class="eyebrow">Automation</p><h1>Boardroom schedules</h1><p>Have a boardroom check routine work automatically and leave a durable report.</p></div>
		</section>
		<div class="schedule-layout">
			<section class="panel schedule-form-panel">
				<h2>Create a schedule</h2>
				if formError != "" {
					<div class="alert alert-error">{ formError }</div>
				}
				<form class="schedule-form" method="post" action="/schedules">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					if IsSoftwareTemplate(template) {
						<label><span>Name</span><input name="name" required maxlength="120" placeholder="Morning software operations review"/></label>
					} else {
						<label><span>Name</span><input name="name" required maxlength="120" placeholder="Morning paperwork review"/></label>
					}
					<label><span>Boardroom</span><select name="boardroom_id" required>
						for _, room := range rooms {
							<option value={ room.ID }>{ room.Name }</option>
						}
					</select></label>
					if IsSoftwareTemplate(template) {
						<label><span>What should it check?</span><textarea name="prompt" required maxlength="12000" placeholder="Review support and SLA risk, failed payments, delivery blockers, and unresolved incident follow-up."></textarea></label>
					} else {
						<label><span>What should it check?</span><textarea name="prompt" required maxlength="12000" placeholder="Review uninvoiced completed jobs, overdue invoices, and tomorrow's schedule conflicts."></textarea></label>
					}
					<div class="interval-fields">
						<label><span>Every</span><input name="every_number" type="number" min="1" max="365" value="1"/></label>
						<label><span>Unit</span><select name="every_unit"><option value="hours">hours</option><option value="days">days</option><option value="weeks">weeks</option></select></label>
					</div>
					<details><summary>Use a cron expression instead</summary><label><span>Cron expression</span><input name="cron_expression" maxlength="200" placeholder="0 7 * * MON-FRI"/><small>If present, this replaces the interval above.</small></label></details>
					<label><span>Time zone</span><input name="time_zone" value="America/New_York" required/><small>Use an IANA name such as America/New_York.</small></label>
					<button class="button button-primary" type="submit">Create durable schedule</button>
				</form>
			</section>
			<section class="schedule-list">
				<div class="section-heading"><div><p class="eyebrow">Recurring work</p><h2>Active schedules</h2></div></div>
				if len(schedules) == 0 {
					if IsSoftwareTemplate(template) {
						<div class="panel empty-schedules"><h3>No schedules yet</h3><p>Create one to let the operating room watch company signals between reviews.</p></div>
					} else {
						<div class="panel empty-schedules"><h3>No schedules yet</h3><p>Create one to let the boardroom keep watch while you are in the field.</p></div>
					}
				}
				for _, item := range schedules {
					<article class="panel schedule-card">
						<header><div><h3>{ item.Name }</h3><span>{ item.BoardroomName }</span></div><span class="status-pill">{ item.State }</span></header>
					<p>{ item.Prompt }</p>
					<dl><div><dt>Runs</dt><dd>{ item.Timing }</dd></div><div><dt>Time zone</dt><dd>{ item.TimeZone }</dd></div></dl>
					if item.LastError != "" {
						<div class="alert alert-error">{ item.LastError }</div>
					}
					<div class="schedule-actions">
						<form method="post" action={ templ.URL("/schedules/" + item.ID + "/trigger") }>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button class="button button-quiet" type="submit">Run now</button>
						</form>
						<form method="post" action={ templ.URL("/schedules/" + item.ID + "/pause") }>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<input type="hidden" name="paused" value={ PauseValue(item.Paused) }/>
							<button class="button button-quiet" type="submit">{ PauseLabel(item.Paused) }</button>
						</form>
						<form method="post" action={ templ.URL("/schedules/" + item.ID + "/delete") }>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button class="button button-danger" type="submit">Delete</button>
						</form>
					</div>
					</article>
				}
			</section>
		</div>
	}
}
