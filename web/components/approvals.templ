package components

import "fmt"

templ ApprovalsPage(tenantName string, user UserView, approvals []ApprovalView, csrfToken, notice, pageError string, includeHistory bool) {
	@Layout("Approvals", tenantName, &user, csrfToken) {
		<section class="hero approvals-hero">
			<div><p class="eyebrow">Owner control</p><h1>Approvals</h1><p>Review completed agent work and consequential proposed actions at the moments where owner judgment is necessary.</p></div>
			<nav class="approval-tabs"><a class={ templ.KV("is-current", !includeHistory) } href="/approvals">Pending</a><a class={ templ.KV("is-current", includeHistory) } href="/approvals?history=1">History</a></nav>
		</section>
		if notice != "" {
			<div class="alert alert-success">{ notice }</div>
		}
		if pageError != "" {
			<div class="alert alert-error">{ pageError }</div>
		}
		if len(approvals) == 0 {
			<section class="panel approval-empty"><h2>No approvals in this view</h2><p>Completed agent work and proposed actions will appear here with their supporting context.</p></section>
		}
		<div class="approval-list">
			for _, approval := range approvals {
				@ApprovalCard(approval, csrfToken)
			}
		</div>
	}
}

templ ApprovalCard(approval ApprovalView, csrfToken string) {
	<article class="panel approval-card">
		<header><div><p class="eyebrow">{ ActionTypeLabel(approval.ActionType) }</p><h2>{ approval.Reason }</h2></div><span class={ "approval-status", "approval-status-" + approval.Status }>{ ApprovalStatusLabel(approval.Status) }</span></header>
		<p>Requested by <strong>{ approval.PersonaName }</strong> <span>({ approval.PersonaRole })</span> on { approval.RequestedAt.Local().Format("Jan 2 at 3:04 PM") }.</p>
		if approval.ActionType == "work.review" && approval.ReviewSummary != "" {
			<div class="approval-work-review"><strong>Agent summary</strong><p>{ approval.ReviewSummary }</p>
				if len(approval.Recommendations) > 0 {
					<strong>Recommendations</strong><ul>
						for _, recommendation := range approval.Recommendations {
							<li>{ recommendation }</li>
						}
					</ul>
				}
			</div>
		}
		if len(approval.Evidence) > 0 {
			<div><strong>Supporting evidence</strong><ul>
				for _, item := range approval.Evidence {
					<li>{ item }</li>
				}
			</ul></div>
		}
		<details><summary>Technical details</summary><pre>{ approval.RequestPayload }</pre></details>
		if approval.WorkItemID != "" {
			<a class="back-link" href={ templ.URL("/work/" + approval.WorkItemID) }>Open ticket #{ fmt.Sprintf("%04d", approval.WorkItemNumber) }</a>
		} else {
			<a class="back-link" href={ templ.URL("/runs/" + approval.RunID) }>Open originating conversation</a>
		}
		if approval.Status == "pending" {
			<footer class="approval-actions">
				<form method="post" action={ templ.URL("/approvals/" + approval.ID + "/reject") }><input type="hidden" name="csrf_token" value={ csrfToken }/><input type="hidden" name="return_tab" value={ ChooseText(approval.ActionType == "work.review", "reviews", "approvals") }/><button class="button button-quiet" type="submit">{ ApprovalRejectLabel(approval.ActionType) }</button></form>
				<form method="post" action={ templ.URL("/approvals/" + approval.ID + "/approve") }><input type="hidden" name="csrf_token" value={ csrfToken }/><input type="hidden" name="return_tab" value={ ChooseText(approval.ActionType == "work.review", "reviews", "approvals") }/><button class="button button-primary" type="submit">{ ApprovalButtonLabel(approval.ActionType) }</button></form>
			</footer>
		}
	</article>
}
