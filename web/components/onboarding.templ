package components

import "fmt"

templ OnboardingPage(tenantName string, user UserView, state OnboardingView, step int, csrfToken, formError string) {
	@Layout("Set up your back office", tenantName, &user, csrfToken) {
		<div class="onboarding-layout">
			<aside class="onboarding-guide">
				<p class="eyebrow">Welcome to Mainspring</p>
				if state.Business.Stage == "" {
					<h2>Choose your starting point</h2><p>We will shape the questions and team around the reality of the business today.</p>
				} else if IsStartingBusiness(state.Business.Stage) {
					<h2>Build your launch room</h2><p>We will pressure-test the idea, plan the first operating system, and propose a lean founding team.</p>
				} else {
					<h2>Build your back office</h2><p>We will learn how your business works, then propose the right team and guardrails.</p>
				}
				<nav class="onboarding-progress" aria-label="Onboarding progress">
					for _, item := range OnboardingSteps() {
						<div class={ "onboarding-progress-item", templ.KV("is-current", item.Number == step), templ.KV("is-complete", item.Number < state.CurrentStep) }>
							<span>{ fmt.Sprintf("%d", item.Number) }</span><strong>{ item.Label }</strong>
						</div>
					}
				</nav>
				<div class="onboarding-agent">
					<div class="agent-avatar">M</div>
					<div><strong>Mia</strong><small>Setup specialist</small></div>
					<p>{ OnboardingAgentPrompt(step, state.Business.Stage) }</p>
				</div>
			</aside>
			<section class="panel onboarding-panel">
				if formError != "" {
					<div class="alert alert-error" role="alert">{ formError }</div>
				}
				if step == 1 {
					if state.Business.Stage == "" {
						@OnboardingStageStep(csrfToken)
					} else {
						@OnboardingBusinessStep(state, csrfToken)
					}
				} else if step == 2 {
					@OnboardingOperationsStep(state, csrfToken)
				} else if step == 3 {
					@OnboardingPrioritiesStep(state, csrfToken)
				} else if step == 4 {
					@OnboardingTeamStep(state, csrfToken)
				} else if step == 5 {
					@OnboardingPermissionsStep(state, csrfToken)
				} else {
					@OnboardingReviewStep(state, csrfToken)
				}
			</section>
		</div>
	}
}

func OnboardingAgentPrompt(step int, stage string) string {
	if stage == "" {
		return "Choose the path that matches reality today. You can set up an operating business or build a new one from first assumptions."
	}
	if IsStartingBusiness(stage) {
		switch step {
		case 1:
			return "We will start with the idea, intended customer, offer, and constraints. It is fine if the name, pricing, or systems are not final."
		case 2:
			return "Describe how you want the first version to work. I will treat it as a hypothesis to test, not an operating fact."
		case 3:
			return "Choose the three launch uncertainties that need evidence or setup first. A shorter list creates a better plan."
		case 4:
			return "I assembled a lean launch team for validation, planning, and setup. Operating roles can join later when the business needs them."
		default:
			return "We are building a launch plan, not pretending the company is already mature. Nothing changes until you approve it."
		}
	}
	switch step {
	case 1:
		return "Start with the facts I should never have to guess: what you do, where you work, and who is on the team."
	case 2:
		return "Talk to me like you would explain the office to a new employee. The exceptions are often more useful than the official process."
	case 3:
		return "Pick the three outcomes that would give you the most time back. We can expand later."
	case 4:
		return "I used your answers to assemble a practical starting team. You can rename anyone or leave a role out."
	case 5:
		return "For launch, each role gets only the research, review, draft, and proposal tools it needs. Sending, paying, signing, and rescheduling stay with you."
	default:
		return "This is the draft I will put in place. Nothing changes until you launch the boardroom."
	}
}

templ OnboardingStageStep(csrfToken string) {
	<header class="onboarding-heading"><p class="eyebrow">Step 1 of 6</p><h1>Where are you starting?</h1><p>The right setup depends on whether Mainspring is learning an operating business or helping you design one from the ground up.</p></header>
	<form class="onboarding-stage-form" method="post" action="/onboarding/stage">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<button class="onboarding-stage-choice" type="submit" name="business_stage" value="operating"><span class="stage-icon">O</span><strong>I already run this business</strong><small>Map the customers, team, systems, paperwork, and exceptions you handle today.</small><em>Set up an operating back office →</em></button>
		<button class="onboarding-stage-choice is-starting" type="submit" name="business_stage" value="starting"><span class="stage-icon">S</span><strong>I am starting from scratch</strong><small>Pressure-test the idea, plan the launch, choose the first systems, and build a lean founding boardroom.</small><em>Build a startup launch room →</em></button>
	</form>
}

templ OnboardingBusinessStep(state OnboardingView, csrfToken string) {
	<header class="onboarding-heading"><p class="eyebrow">Step 1 of 6</p>
		if IsStartingBusiness(state.Business.Stage) {
			<h1>Describe the business you want to start</h1><p>Working assumptions are welcome. Your launch team will help turn unknowns into questions and tests.</p>
		} else {
			<h1>Tell us about the business</h1><p>These facts become the shared context for every person in your operating team.</p>
		}
		<form class="onboarding-path-switch" method="post" action="/onboarding/stage"><input type="hidden" name="csrf_token" value={ csrfToken }/>
			if IsStartingBusiness(state.Business.Stage) {
				<span>Path: Starting from scratch</span><button type="submit" name="business_stage" value="operating">Use existing business instead</button>
			} else {
				<span>Path: Existing business</span><button type="submit" name="business_stage" value="starting">Start from scratch instead</button>
			}
		</form>
	</header>
	<form class="onboarding-form" method="post" action="/onboarding/business">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<div class="form-grid">
			if IsSoftwareTemplate(state.Template) {
				<label><span>Company name</span><input name="business_name" required maxlength="160" value={ state.Business.BusinessName } placeholder="Demo Software Co."/></label>
				<label><span>Business model</span><input name="trade" required maxlength="120" value={ state.Business.Trade } placeholder="B2B SaaS, vertical SaaS, MSP, IT consultancy..."/></label>
			} else {
				<label><span>Business name</span><input name="business_name" required maxlength="160" value={ state.Business.BusinessName } placeholder="Demo Trade Co."/></label>
				<label><span>Primary trade</span><input name="trade" required maxlength="120" value={ state.Business.Trade } placeholder="Plumbing, HVAC, electrical..."/></label>
			}
		</div>
		<label><span>Business website <small>optional</small></span><input name="website_url" type="url" maxlength="500" value={ state.Business.WebsiteURL } placeholder="https://www.example.com"/><small>
			if IsStartingBusiness(state.Business.Stage) {
				<span>A website is not required yet. If you have a draft public site, the Website Advisor can review it.</span>
			} else {
				<span>The Website Advisor can inspect this public site and recommend changes; it cannot edit or publish the site.</span>
			}
		</small></label>
		if IsSoftwareTemplate(state.Template) {
			<label><span>Products and managed services</span><textarea name="services" maxlength="1000" placeholder="What you build or manage, who uses it, plans, packages, and recurring services...">{ state.Business.Services }</textarea></label>
		} else {
			<label><span>Services you provide</span><textarea name="services" maxlength="1000" placeholder="Service calls, installations, maintenance agreements...">{ state.Business.Services }</textarea></label>
		}
		<div class="form-grid">
			if IsSoftwareTemplate(state.Template) {
				<label><span>Target market</span><input name="service_area" required maxlength="240" value={ state.Business.ServiceArea } placeholder="North American field-service companies with 10–100 employees"/></label>
			} else {
				<label><span>Service area</span><input name="service_area" required maxlength="240" value={ state.Business.ServiceArea } placeholder="Charlotte and surrounding counties"/></label>
			}
			<label><span>Time zone</span><input name="time_zone" required value={ state.Business.TimeZone } placeholder="America/New_York"/></label>
			<label><span>People in the business</span><input name="team_size" type="number" min="1" max="10000" value={ fmt.Sprintf("%d", state.Business.TeamSize) }/></label>
			<label><span>Customer model</span><select name="customer_mix">
				for _, option := range CustomerMixOptions(state.Template) {
					<option value={ option.Value } selected?={ state.Business.CustomerMix == option.Value || (option.Value == "mixed" && state.Business.CustomerMix == "") }>{ option.Label }</option>
				}
			</select></label>
		</div>
		if IsSoftwareTemplate(state.Template) {
			<label><span>Team working rhythm</span><input name="working_hours" maxlength="240" value={ state.Business.WorkingHours } placeholder="Distributed team; core hours 10 AM–4 PM Eastern"/></label>
			<label class="check-row"><input name="emergency_service" type="checkbox" value="true" checked?={ state.Business.EmergencyService }/><span>We operate an after-hours incident or customer escalation rotation</span></label>
		} else {
			<label><span>Normal working hours</span><input name="working_hours" maxlength="240" value={ state.Business.WorkingHours } placeholder="Monday–Friday, 7:00 AM–5:00 PM"/></label>
			<label class="check-row"><input name="emergency_service" type="checkbox" value="true" checked?={ state.Business.EmergencyService }/><span>We handle emergency or after-hours calls</span></label>
		}
		<fieldset><legend>{ ChooseText(IsStartingBusiness(state.Business.Stage), "Systems you have chosen so far", "Systems you already use") }</legend><div class="choice-grid">
			for _, system := range ExistingSystemOptions(state.Template) {
				@CheckChoice("current_systems", system, Contains(state.Business.CurrentSystems, system))
			}
		</div></fieldset>
		<div class="onboarding-actions"><span></span><button class="button button-primary" type="submit">Continue to how work flows</button></div>
	</form>
}

templ OnboardingOperationsStep(state OnboardingView, csrfToken string) {
	<header class="onboarding-heading"><p class="eyebrow">Step 2 of 6</p>
		if IsStartingBusiness(state.Business.Stage) {
			<h1>Design the first operating playbook</h1><p>Describe the simplest version that could work at launch. These are hypotheses, not promises.</p>
		} else {
			<h1>Walk Mia through the office</h1><p>Short, imperfect answers are fine. Describe what really happens today.</p>
		}
	</header>
	<form class="onboarding-form" method="post" action="/onboarding/operations">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		if IsStartingBusiness(state.Business.Stage) && IsSoftwareTemplate(state.Template) {
			<label><span>How do you expect the first prospects or design partners to find you?</span><textarea name="lead_intake" required maxlength="1600" placeholder="Founder network, interviews, a niche community, targeted outreach, content...">{ state.Operations.LeadIntake }</textarea></label>
			<label><span>How will you decide what belongs in the first product or service release?</span><textarea name="scheduling" required maxlength="1600" placeholder="Customer evidence, founder judgment, a weekly priority review, explicit exclusions...">{ state.Operations.Scheduling }</textarea></label>
			<label><span>How will a validated problem become delivery work?</span><textarea name="estimate_to_job" maxlength="1600">{ state.Operations.EstimateToJob }</textarea></label>
			<label><span>How should the first customer receive value and become billable?</span><textarea name="job_to_invoice" required maxlength="1600">{ state.Operations.JobToInvoice }</textarea></label>
			<div class="form-grid"><label><span>What pricing, payment, or renewal model are you considering?</span><textarea name="payments" maxlength="1600">{ state.Operations.Payments }</textarea></label><label><span>What startup, cloud, contractor, or software costs do you expect?</span><textarea name="vendor_bills" maxlength="1600">{ state.Operations.VendorBills }</textarea></label></div>
			<label><span>What is the biggest unknown that could make this business fail?</span><textarea name="biggest_bottleneck" required maxlength="1600">{ state.Operations.BiggestBottleneck }</textarea></label>
			<label><span>What constraints must the launch plan respect?</span><textarea name="important_exceptions" maxlength="1600" placeholder="Runway, evenings-only availability, a regulated market, a fixed launch date...">{ state.Operations.ImportantExceptions }</textarea></label>
		} else if IsStartingBusiness(state.Business.Stage) {
			<label><span>How do you expect the first leads and customer conversations to happen?</span><textarea name="lead_intake" required maxlength="1600" placeholder="Referrals, local partnerships, door hangers, search, a small outreach list...">{ state.Operations.LeadIntake }</textarea></label>
			<label><span>How should the first jobs be scheduled and assigned?</span><textarea name="scheduling" required maxlength="1600" placeholder="The owner takes calls, confirms a window, and keeps one shared calendar...">{ state.Operations.Scheduling }</textarea></label>
			<label><span>How should a request become a priced and approved job?</span><textarea name="estimate_to_job" maxlength="1600">{ state.Operations.EstimateToJob }</textarea></label>
			<label><span>How should completed work become an invoice and payment?</span><textarea name="job_to_invoice" required maxlength="1600">{ state.Operations.JobToInvoice }</textarea></label>
			<div class="form-grid"><label><span>What payment terms and follow-up will you start with?</span><textarea name="payments" maxlength="1600">{ state.Operations.Payments }</textarea></label><label><span>What startup, equipment, material, and vendor costs do you expect?</span><textarea name="vendor_bills" maxlength="1600">{ state.Operations.VendorBills }</textarea></label></div>
			<label><span>What is the biggest unknown that could make this business fail?</span><textarea name="biggest_bottleneck" required maxlength="1600">{ state.Operations.BiggestBottleneck }</textarea></label>
			<label><span>What constraints must the launch plan respect?</span><textarea name="important_exceptions" maxlength="1600" placeholder="Licensing, insurance, limited startup cash, evenings-only availability...">{ state.Operations.ImportantExceptions }</textarea></label>
		} else if IsSoftwareTemplate(state.Template) {
			<label><span>How do demand, leads, and customer requests arrive?</span><textarea name="lead_intake" required maxlength="1600" placeholder="Organic search, product-led signups, founder sales, partner referrals...">{ state.Operations.LeadIntake }</textarea></label>
			<label><span>How are product, project, support, and recurring-service priorities decided?</span><textarea name="scheduling" required maxlength="1600" placeholder="Roadmap planning, ticket triage, SLA queues, projects, maintenance windows, and incidents...">{ state.Operations.Scheduling }</textarea></label>
			<label><span>How does discovery or a customer request become delivery work?</span><textarea name="estimate_to_job" maxlength="1600">{ state.Operations.EstimateToJob }</textarea></label>
			<label><span>How does completed product or service work reach customers and billing?</span><textarea name="job_to_invoice" required maxlength="1600">{ state.Operations.JobToInvoice }</textarea></label>
			<div class="form-grid">
				<label><span>How are subscriptions, contracts, failed payments, and renewals handled?</span><textarea name="payments" maxlength="1600">{ state.Operations.Payments }</textarea></label>
				<label><span>How are cloud, licensing, contractor, and vendor costs handled?</span><textarea name="vendor_bills" maxlength="1600">{ state.Operations.VendorBills }</textarea></label>
			</div>
			<label><span>What coordination or information problem costs the company the most time?</span><textarea name="biggest_bottleneck" required maxlength="1600">{ state.Operations.BiggestBottleneck }</textarea></label>
			<label><span>Anything unusual a new operations lead needs to know?</span><textarea name="important_exceptions" maxlength="1600" placeholder="Enterprise security reviews pause deals; P1 incidents override planned work; some clients have custom SLAs...">{ state.Operations.ImportantExceptions }</textarea></label>
		} else {
			<label><span>How do new leads and customer requests arrive?</span><textarea name="lead_intake" required maxlength="1600" placeholder="Phone calls come to me, web leads go to a shared inbox...">{ state.Operations.LeadIntake }</textarea></label>
			<label><span>How are jobs scheduled and assigned?</span><textarea name="scheduling" required maxlength="1600" placeholder="I keep the calendar and text each technician the night before...">{ state.Operations.Scheduling }</textarea></label>
			<label><span>How does an estimate become an active job?</span><textarea name="estimate_to_job" maxlength="1600">{ state.Operations.EstimateToJob }</textarea></label>
			<label><span>How does completed work become an invoice?</span><textarea name="job_to_invoice" required maxlength="1600">{ state.Operations.JobToInvoice }</textarea></label>
			<div class="form-grid">
				<label><span>How are payments and overdue invoices handled?</span><textarea name="payments" maxlength="1600">{ state.Operations.Payments }</textarea></label>
				<label><span>How are vendor bills handled?</span><textarea name="vendor_bills" maxlength="1600">{ state.Operations.VendorBills }</textarea></label>
			</div>
			<label><span>What paperwork or coordination problem costs you the most time?</span><textarea name="biggest_bottleneck" required maxlength="1600">{ state.Operations.BiggestBottleneck }</textarea></label>
			<label><span>Anything unusual a new office manager needs to know?</span><textarea name="important_exceptions" maxlength="1600" placeholder="Commercial work needs a PO before invoicing; emergencies can displace maintenance calls...">{ state.Operations.ImportantExceptions }</textarea></label>
		}
		<div class="onboarding-actions"><a href="/onboarding?step=1">Back</a><button class="button button-primary" type="submit">Continue to priorities</button></div>
	</form>
}

templ OnboardingPrioritiesStep(state OnboardingView, csrfToken string) {
	<header class="onboarding-heading"><p class="eyebrow">Step 3 of 6</p><h1>{ ChooseText(IsStartingBusiness(state.Business.Stage), "What must the launch team solve first?", "Where should the team help first?") }</h1><p>Choose up to three. This shapes the team Mainspring proposes.</p></header>
	<form class="onboarding-form" method="post" action="/onboarding/priorities">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<div class="priority-grid">
			for _, priority := range PriorityOptionsForOnboarding(state.Template, state.Business.Stage) {
				<label class="priority-choice"><input type="checkbox" name="priorities" value={ priority } checked?={ Contains(state.Priorities, priority) }/><span>{ priority }</span></label>
			}
		</div>
		<div class="onboarding-actions"><a href="/onboarding?step=2">Back</a><button class="button button-primary" type="submit">Build my team</button></div>
	</form>
}

templ OnboardingTeamStep(state OnboardingView, csrfToken string) {
	<header class="onboarding-heading"><p class="eyebrow">Step 4 of 6</p><h1>Build the right boardroom</h1><p>Start lean, then add specialists where their perspective earns a seat. These are bounded job descriptions, not generic chat personalities.</p></header>
	<div class="team-guidance"><strong>Resource-conscious by design</strong><p>{ ChooseText(IsStartingBusiness(state.Business.Stage), "Three launch roles form the core for validation, planning, and setup. Matching priorities may recommend a specialist, and you control the final team.", "The three core operators begin selected. Optional specialists only join conversations when you include them, and every role receives its own limited toolset.") }</p></div>
	<form class="onboarding-form" method="post" action="/onboarding/team">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		for _, group := range PersonaGroupsForOnboarding(state.Personas, state.Template, state.Business.Stage) {
			<section class="persona-group">
				<header class="persona-group-heading"><div><p class="eyebrow">{ group.Name }</p><p>{ group.Description }</p></div></header>
				<div class="persona-proposals">
					for _, persona := range group.Personas {
						<article class={ "persona-proposal", templ.KV("is-selected", persona.Enabled) }>
							<header><span class="avatar">{ Initial(persona.Name) }</span><div><strong>{ persona.Role }</strong><small>{ persona.Mission }</small></div><label class="persona-toggle"><input type="checkbox" name={ "enabled_" + persona.Key } value="true" checked?={ persona.Enabled }/><span>Include</span></label></header>
							<label><span>Name</span><input name={ "name_" + persona.Key } required maxlength="80" value={ persona.Name }/></label>
							<ul>
								for _, capability := range persona.Capabilities {
									<li>{ capability }</li>
								}
							</ul>
						</article>
					}
				</div>
			</section>
		}
		<div class="onboarding-actions"><a href="/onboarding?step=3">Back</a><button class="button button-primary" type="submit">Set authority</button></div>
	</form>
}

templ OnboardingPermissionsStep(state OnboardingView, csrfToken string) {
	<header class="onboarding-heading"><p class="eyebrow">Step 5 of 6</p><h1>Decide what the team may do</h1><p>Grant only the research, review, draft, and proposal authority this boardroom needs.</p></header>
	<form class="onboarding-form" method="post" action="/onboarding/permissions">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<div class="permission-list">
			if IsSoftwareTemplate(state.Template) {
				@PermissionChoice("read_business_records", "Read connected company records", "Documents, product work, support records, calendars, revenue, and operating data that you connect.", state.Permissions.ReadBusinessRecords)
			} else {
				@PermissionChoice("read_business_records", "Read connected business records", "Documents, job information, calendars, and accounting records that you connect.", state.Permissions.ReadBusinessRecords)
			}
			@PermissionChoice("research_public_web", "Research the public web", "Research-focused specialists can search public sources; findings must cite evidence and remain advisory.", state.Permissions.ResearchPublicWeb)
			@PermissionChoice("comment_on_documents", "Add review comments to documents", "Legal, compliance, and safety specialists may annotate documents, but cannot replace or delete them.", state.Permissions.CommentOnDocuments)
			if IsSoftwareTemplate(state.Template) {
				@PermissionChoice("prepare_invoice_drafts", "Prepare billing drafts", "The revenue analyst can organize subscription or service billing details, but cannot issue a charge.", state.Permissions.PrepareInvoiceDrafts)
			} else {
				@PermissionChoice("prepare_invoice_drafts", "Prepare invoice drafts", "The bookkeeper can organize invoice details, but cannot issue an invoice.", state.Permissions.PrepareInvoiceDrafts)
			}
			@PermissionChoice("draft_customer_email", "Draft customer messages", "The office manager can prepare follow-ups for you to review and send.", state.Permissions.DraftCustomerEmail)
			@PermissionChoice("read_email_inbox", "Read the connected email inbox", "Selected communication personas can review incoming email after a mailbox is connected.", state.Permissions.ReadEmailInbox)
			@PermissionChoice("send_email", "Send email through SMTP", "Selected communication personas may send external email. Every send is idempotent and written to the outbound audit ledger.", state.Permissions.SendEmail)
			if IsSoftwareTemplate(state.Template) {
				@PermissionChoice("propose_schedule_edits", "Propose planning changes", "Product and engineering roles can flag delivery conflicts and suggest priority changes, but cannot apply them.", state.Permissions.ProposeScheduleEdits)
				@PermissionChoice("propose_payments", "Propose vendor payments", "The revenue analyst can prepare a payment recommendation; execution always requires approval.", state.Permissions.ProposePayments)
			} else {
				@PermissionChoice("propose_schedule_edits", "Propose schedule changes", "The dispatcher can point out conflicts and suggest moves, but cannot apply them.", state.Permissions.ProposeScheduleEdits)
				@PermissionChoice("propose_payments", "Propose payments", "The bookkeeper can prepare a payment recommendation; execution always requires approval.", state.Permissions.ProposePayments)
			}
		</div>
		<div class="guardrail"><strong>Hard guardrail</strong><p>Email sending is disabled unless you explicitly grant it and connect a mailbox; every send is idempotent and audited. Invoice issuing, payment execution, ordering, contract acceptance, and calendar modification remain disabled. Legal and HR guidance is advisory and must be reviewed by a qualified human.</p></div>
		<div class="onboarding-actions"><a href="/onboarding?step=4">Back</a><button class="button button-primary" type="submit">Review the plan</button></div>
	</form>
}

templ OnboardingReviewStep(state OnboardingView, csrfToken string) {
	<header class="onboarding-heading"><p class="eyebrow">Step 6 of 6</p><h1>Ready to open the doors</h1><p>Review the structured draft. Launching applies it to your boardroom and its personas.</p></header>
	<div class="review-grid">
		<section><h3>Business</h3><dl><div><dt>Stage</dt><dd>{ ChooseText(IsStartingBusiness(state.Business.Stage), "Starting from scratch", "Operating business") }</dd></div><div><dt>Name</dt><dd>{ state.Business.BusinessName }</dd></div><div><dt>Website</dt><dd>{ state.Business.WebsiteURL }</dd></div>
			if IsSoftwareTemplate(state.Template) {
				<div><dt>Model</dt><dd>{ state.Business.Trade }</dd></div><div><dt>Target market</dt><dd>{ state.Business.ServiceArea }</dd></div>
			} else {
				<div><dt>Trade</dt><dd>{ state.Business.Trade }</dd></div><div><dt>Service area</dt><dd>{ state.Business.ServiceArea }</dd></div>
			}
			<div><dt>Team</dt><dd>{ fmt.Sprintf("%d people", state.Business.TeamSize) }</dd></div></dl><a href="/onboarding?step=1">Edit business</a></section>
		<section><h3>Top priorities</h3><ul>
			for _, priority := range state.Priorities {
				<li>{ priority }</li>
			}
		</ul><a href="/onboarding?step=3">Edit priorities</a></section>
		<section><h3>Operating playbook</h3><dl>
			if IsSoftwareTemplate(state.Template) {
				<div><dt>Delivery to customer</dt><dd>{ state.Operations.JobToInvoice }</dd></div>
			} else {
				<div><dt>Job to invoice</dt><dd>{ state.Operations.JobToInvoice }</dd></div>
			}
			<div><dt>Biggest bottleneck</dt><dd>{ state.Operations.BiggestBottleneck }</dd></div><div><dt>Important exception</dt><dd>{ state.Operations.ImportantExceptions }</dd></div></dl><a href="/onboarding?step=2">Edit playbook</a></section>
		<section><h3>Launch authority</h3><ul>
			for _, permission := range PermissionSummary(state.Permissions) {
				<li>{ permission }</li>
			}
		</ul><p class="review-guardrail">Sending, issuing, paying, ordering, signing, and modifying remain disabled.</p><a href="/onboarding?step=5">Edit authority</a></section>
		<section class="review-team"><h3>{ state.BoardroomName }</h3><p>{ state.BoardroomDescription }</p>
			for _, persona := range state.Personas {
				if persona.Enabled {
					<div><span class="avatar avatar-small">{ Initial(persona.Name) }</span><strong>{ persona.Name }</strong><small>{ persona.Role }</small></div>
				}
			}
			<a href="/onboarding?step=4">Edit team</a>
		</section>
	</div>
	<div class="launch-note"><strong>What happens next?</strong><p>Your boardroom will open with this context. Start with a real situation or use the suggested test conversation.</p></div>
	<form method="post" action="/onboarding/launch">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<div class="onboarding-actions"><a href="/onboarding?step=5">Back</a><button class="button button-primary" type="submit">
			if IsSoftwareTemplate(state.Template) {
				<span>Launch my operating room</span>
			} else {
				<span>Launch my back office</span>
			}
		</button></div>
	</form>
}

templ CheckChoice(name, value string, checked bool) {
	<label class="check-choice"><input type="checkbox" name={ name } value={ value } checked?={ checked }/><span>{ value }</span></label>
}

templ PermissionChoice(name, title, description string, checked bool) {
	<label class="permission-choice"><input type="checkbox" name={ name } value="true" checked?={ checked }/><span><strong>{ title }</strong><small>{ description }</small></span></label>
}

templ OnboardingCompletePage(tenantName string, user UserView, room BoardroomCardView, csrfToken, template, stage string) {
	@Layout("Your back office is ready", tenantName, &user, csrfToken) {
		<section class="completion-card panel">
			<div class="spring-glyph">M</div><p class="eyebrow">Onboarding complete</p><h1>{ room.Name } is ready</h1><p>Mainspring has applied your business profile, operating playbook, personas, and launch permissions.</p>
			<div class="test-drive-card"><strong>Suggested first conversation</strong><p>{ SuggestedFirstConversation(template, stage) }</p></div>
			<div class="completion-actions"><a class="button button-primary" href={ templ.URL("/boardrooms/" + room.ID) }>Open { room.Name }</a><a class="button button-quiet" href="/">Go to dashboard</a></div>
		</section>
	}
}

templ DevelopmentPage(tenantName string, user UserView, csrfToken string) {
	@Layout("Demo tools", tenantName, &user, csrfToken) {
		<section class="development-shell">
			<header><p class="eyebrow">Development only</p><h1>Demo tools</h1><p>Utilities for repeatedly testing the customer experience. These routes do not exist when Mainspring is not running in development mode.</p></header>
			<article class="panel development-card"><div><h2>Reset onboarding</h2><p>Clears the onboarding draft and restores this tenant template's default personas. Your owner login, conversations, documents, and connected mailbox are preserved.</p></div><form method="post" action="/development/reset-onboarding"><input type="hidden" name="csrf_token" value={ csrfToken }/><input type="hidden" name="confirm" value="reset"/><button class="button button-danger-solid" type="submit">Reset onboarding</button></form></article>
		</section>
	}
}
