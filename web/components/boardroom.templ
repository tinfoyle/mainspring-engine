package components

import "fmt"

templ BoardroomPage(tenantName string, user UserView, room BoardroomCardView, personas []PersonaView, conversations []ConversationView, csrfToken, template string) {
	@Layout(room.Name, tenantName, &user, csrfToken) {
		<div class="boardroom-layout">
			@BoardroomSidebar(room, personas, "/")
			<section class="boardroom-main panel">
				<header class="conversation-list-header">
					if template == "saas" {
						<div><p class="eyebrow">Workspace</p><h2>Conversations</h2><p>Keep each product, customer, growth, or operating question in its own continuing conversation.</p></div>
					} else {
						<div><p class="eyebrow">Workspace</p><h2>Conversations</h2><p>Keep each job, question, or issue in its own continuing conversation.</p></div>
					}
				</header>
				<form class="prompt-form prompt-form-new" method="post" action={ templ.URL("/boardrooms/" + room.ID + "/conversations") }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label for="prompt">Start a new conversation</label>
					if template == "saas" {
						<textarea id="prompt" name="prompt" required maxlength="12000" placeholder="Review customer, roadmap, revenue, and delivery signals and tell me what needs attention."></textarea>
					} else {
						<textarea id="prompt" name="prompt" required maxlength="12000" placeholder="Review completed jobs that have not been invoiced and tell me what needs attention."></textarea>
					}
					<button class="button button-primary" type="submit">Convene boardroom</button>
				</form>
				<div class="conversation-list">
					if len(conversations) == 0 {
						if template == "saas" {
							<div class="empty-run"><div class="spring-glyph">M</div><h2>No conversations yet</h2><p>Start with a product, customer, growth, or operating situation that needs the team's attention.</p></div>
						} else {
							<div class="empty-run"><div class="spring-glyph">M</div><h2>No conversations yet</h2><p>Start with a job, question, or situation that needs the back office's attention.</p></div>
						}
					}
					for _, conversation := range conversations {
						<a class="conversation-card" href={ templ.URL("/conversations/" + conversation.ID) }>
							<div><span class="conversation-source">{ ConversationSourceLabel(conversation.Source) }</span><h3>{ conversation.Title }</h3><p>{ conversation.LatestPrompt }</p></div>
							<footer><span>{ conversation.UpdatedAt.Local().Format("Jan 2 at 3:04 PM") }</span><span>{ fmt.Sprintf("%d messages", conversation.MessageCount) }</span><span class={ "conversation-state", "conversation-state-" + conversation.LatestStatus }>{ RunStatusLabel(conversation.LatestStatus) }</span></footer>
						</a>
					}
				</div>
			</section>
		</div>
	}
}

templ ConversationPage(tenantName string, user UserView, room BoardroomCardView, personas []PersonaView, conversation ConversationView, run RunView, messages []MessageView, csrfToken string) {
	@Layout(conversation.Title, tenantName, &user, csrfToken) {
		<div class="boardroom-layout">
			@BoardroomSidebar(room, personas, "/boardrooms/" + room.ID)
			<section class="boardroom-main panel" hx-ext="sse" sse-connect={ templ.URL(fmt.Sprintf("/runs/%s/events?after=%d", run.ID, run.EventCursor)) } sse-close="finished">
				<header class="run-header">
					<div><p class="eyebrow">Conversation</p><h1 class="conversation-title">{ conversation.Title }</h1><p class="conversation-meta">{ ConversationSourceLabel(conversation.Source) } &middot; Updated { conversation.UpdatedAt.Local().Format("Jan 2 at 3:04 PM") }</p></div>
					<div id="current-run-status" sse-swap="status" hx-swap="innerHTML">@RunStatus(run)</div>
				</header>
				<div class="conversation">
					<div id="messages" sse-swap="message" hx-swap="beforeend">
						for _, message := range messages {
							@MessageBubble(message)
						}
					</div>
					<div id="follow-up" sse-swap="finished" hx-swap="innerHTML">
						if RunIsTerminal(run.Status) {
							@FollowUpForm(conversation.ID, csrfToken)
						}
					</div>
				</div>
			</section>
		</div>
	}
}

templ BoardroomSidebar(room BoardroomCardView, personas []PersonaView, backURL string) {
	<aside class="boardroom-sidebar panel">
		<a class="back-link" href={ templ.URL(backURL) }>&larr; Back</a>
		<p class="eyebrow">Boardroom</p><h2>{ room.Name }</h2><p>{ room.Description }</p>
		<div class="persona-list">
			for _, persona := range personas {
				<div class="persona-row"><span class="avatar">{ Initial(persona.Name) }</span><div><strong>{ persona.Name }</strong><small>{ persona.Role }</small></div></div>
			}
		</div>
	</aside>
}

templ FollowUpForm(conversationID, csrfToken string) {
	<div class="follow-up-ready"><p><strong>The boardroom is ready for your follow-up.</strong></p><p>Continue this conversation or return to the boardroom to start a separate piece of work.</p></div>
	<form class="prompt-form follow-up-form" method="post" action={ templ.URL("/conversations/" + conversationID + "/runs") }>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<label for="follow-up-prompt">Ask a follow-up</label>
		<textarea id="follow-up-prompt" name="prompt" required maxlength="12000" placeholder="Ask for clarification, give the team more information, or tell them what to do next."></textarea>
		<button class="button button-primary" type="submit">Continue conversation</button>
	</form>
}

templ MessageBubble(message MessageView) {
	<article class={ "message", templ.KV("message-user", message.Role == "user") } data-message-id={ message.ID }>
		<header>
			if message.Role == "user" {
				<strong>You</strong><span>Request</span>
			} else {
				<span class="avatar avatar-small">{ Initial(message.PersonaName) }</span><div><strong>{ message.PersonaName }</strong><span>{ message.PersonaRole }</span></div>
			}
			<time>{ message.CreatedAt.Local().Format("3:04 PM") }</time>
		</header>
		<p>{ message.Body }</p>
	</article>
}

templ RunStatus(run RunView) {
	<div class={ "run-status", "run-status-" + run.Status }><span class="run-dot"></span><strong>{ RunStatusLabel(run.Status) }</strong>
		if run.TurnCount > 0 {
			<small>{ fmt.Sprintf("%d turns", run.TurnCount) }</small>
		}
	</div>
}

templ StatusFragment(run RunView) {
	@RunStatus(run)
}
