{
  "name": "@spyglass/customer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:social-card": "node scripts/render-social-card.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "budget": "node scripts/verify-budgets.mjs",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run build && npm run budget"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
