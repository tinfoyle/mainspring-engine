{
  "name": "@spyglass/customer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:social-card": "node scripts/render-social-card.mjs",
    "browser:app": "playwright test --config playwright.config.ts",
    "browser:identity": "playwright test --config playwright.identity.config.ts",
    "browser:operations": "playwright test --config playwright.operations.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "public:a11y": "node scripts/verify-public-accessibility.mjs",
    "budget": "node scripts/verify-budgets.mjs",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run build && npm run public:a11y && npm run budget"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@eslint/js": "9.39.4",
    "@resvg/resvg-js": "2.6.2",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "globals": "16.4.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
