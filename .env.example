# Shared
MAINSPRING_ENV=development
MAINSPRING_LOG_LEVEL=info
MAINSPRING_SHUTDOWN_TIMEOUT=10s
MAINSPRING_AUTO_MIGRATE=true

# Control plane
MAINSPRING_CONTROL_ADDR=:8080
MAINSPRING_CONTROL_DATABASE_URL=postgres://mainspring:mainspring@localhost:5432/mainspring_control?sslmode=disable
MAINSPRING_CONTROL_ADMIN_TOKEN=replace-with-a-random-control-admin-token-at-least-32-bytes

# Tenant gateway
MAINSPRING_GATEWAY_ADDR=:8081
MAINSPRING_GATEWAY_BASE_DOMAIN=localhost
MAINSPRING_GATEWAY_ROUTE_CACHE_TTL=10s

# Tenant runtime
MAINSPRING_TENANT_ADDR=:8082
MAINSPRING_TENANT_ID=00000000-0000-0000-0000-000000000001
MAINSPRING_TENANT_SLUG=demo
MAINSPRING_TENANT_NAME=Demo Trade Co.
# Supported values: trades or software (saas remains a compatibility alias).
MAINSPRING_TENANT_TEMPLATE=trades
MAINSPRING_TENANT_INTERNAL_URL=http://tenant-demo:8082
MAINSPRING_TENANT_DATABASE_URL=postgres://tenant_demo:tenant_demo@localhost:5432/tenant_demo?sslmode=disable
MAINSPRING_SESSION_SECRET=replace-with-at-least-32-random-bytes
MAINSPRING_SETUP_TOKEN=replace-with-a-one-time-setup-token
MAINSPRING_COOKIE_SECURE=false
MAINSPRING_RUN_CONCURRENCY=4
MAINSPRING_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-bytes
MAINSPRING_EMAIL_PROVIDER=network

# Temporal
MAINSPRING_TEMPORAL_ADDRESS=localhost:7233
MAINSPRING_TEMPORAL_NAMESPACE=default
MAINSPRING_TEMPORAL_TASK_QUEUE=
MAINSPRING_ORCHESTRATION=local

# Agent runtime
MAINSPRING_AGENT_PROVIDER=mock
MAINSPRING_CODEX_BINARY=codex
MAINSPRING_AGENT_TIMEOUT=5m
MAINSPRING_TOOL_TOKEN_SECRET=replace-with-a-separate-random-secret-at-least-32-bytes
MAINSPRING_RAG_ADDR=:8083
MAINSPRING_RAG_INTERNAL_URL=http://localhost:8083
MAINSPRING_RAG_TOKEN=replace-with-a-separate-random-rag-secret-at-least-32-bytes
