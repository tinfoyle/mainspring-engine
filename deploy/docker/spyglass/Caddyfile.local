{
  admin off
}

(web_routes) {
  header {
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  @privacy_api path /api/v1/privacy /api/v1/privacy/* /api/v1/analytics/events
  handle @privacy_api {
    reverse_proxy account-api:8080
  }
  handle {
    reverse_proxy website:3000
  }
}

(app_routes) {
  @cell_api path_regexp cell_api ^/api/v1/accounts/[^/]+/(context|attention(?:/.*)?|knowledge(?:/.*)?|work-items(?:/.*)?|agent-(?:boardrooms|conversations|runs)(?:/.*)?|schedules(?:/.*)?|finance(?:/.*)?|integrations(?:/.*)?)$
  handle @cell_api {
    reverse_proxy app-router:8080
  }
  @vue {
    method GET HEAD
    path /app /app/your-turn /app/your-turn/* /app/work /app/work/* /app/knowledge /app/knowledge/* /app/baseline /app/baseline/* /app/agents /app/agents/* /app/schedules /app/schedules/* /app/finance /app/finance/* /app/integrations /app/integrations/* /app/marketing /app/marketing/* /app/account /app/billing /app/security /app/account-exports /app/account-closures /app/privacy /app/checkout /app/affiliate /ui-assets/*
  }
  handle @vue {
    reverse_proxy private-ui:8080
  }
  handle {
    reverse_proxy account-api:8080
  }
}

http://web.infiniteocean.localhost {
  request_header Host web.infiniteocean.localhost:8444
  request_header Origin https://web.infiniteocean.localhost:8444
  import web_routes
}

web.infiniteocean.localhost {
  tls internal
  import web_routes
}

http://app.infiniteocean.localhost {
  request_header Host app.infiniteocean.localhost:8444
  request_header Origin https://app.infiniteocean.localhost:8444
  import app_routes
}

app.infiniteocean.localhost {
  tls internal
  import app_routes
}

oauth.infiniteocean.localhost {
  tls internal
  reverse_proxy google-oauth-fixture:8080
}

mcp.infiniteocean.localhost {
  tls internal
  reverse_proxy mcp-gateway:8080
}
