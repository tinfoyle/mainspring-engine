{
  admin off
}

(web_routes) {
  @privacy_api path /api/v1/privacy /api/v1/privacy/* /api/v1/analytics/events
  handle @privacy_api {
    reverse_proxy account-api:8080
  }
  handle {
    reverse_proxy website:3000
  }
}

(app_routes) {
  @cell_api path_regexp cell_api ^/api/v1/accounts/[^/]+/(context|attention(?:/.*)?|knowledge(?:/.*)?|work-items(?:/.*)?|agent-(?:boardrooms|conversations|runs)(?:/.*)?|integrations(?:/.*)?)$
  handle @cell_api {
    reverse_proxy app-router:8080
  }
  @vue {
    method GET HEAD
    path /app /app/your-turn /app/your-turn/* /app/work /app/knowledge /app/agents /app/privacy /app/checkout /app/affiliate /ui-assets/*
  }
  handle @vue {
    reverse_proxy private-ui:8080
  }
  handle {
    reverse_proxy account-api:8080
  }
}

web.infiniteocean.localhost {
  tls internal
  import web_routes
}

app.infiniteocean.localhost {
  tls internal
  import app_routes
}

oauth.infiniteocean.localhost {
  tls internal
  reverse_proxy google-oauth-fixture:8080
}

mcp.infiniteocean.localhost {
  tls internal
  reverse_proxy mcp-gateway:8080
}
