#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  inspect)
    printf '%s\n' spyglass-stage
    ;;
  exec)
    while IFS= read -r _; do :; done
    count=0
    if [[ -f "$SPYGLASS_RESET_FAKE_STATE" ]]; then
      read -r count <"$SPYGLASS_RESET_FAKE_STATE"
    fi
    count=$((count+1))
    printf '%s\n' "$count" >"$SPYGLASS_RESET_FAKE_STATE"
    if [[ "$count" -eq 1 ]]; then
      printf '%s\t%s\t%s\t%s\n' \
        11111111-1111-4111-8111-111111111111 \
        22222222-2222-4222-8222-222222222222 \
        cell-us-east-01 1
    else
      printf '%s\n' 'guard accepted synthetic fixture'
    fi
    ;;
  *)
    printf 'unexpected fake docker command: %s\n' "${1:-}" >&2
    exit 1
    ;;
esac
