# Replace the existing Hostinger security_headers snippet with this definition.
# Keep it before every site block so Caddy expands imports consistently.
(security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }
}
