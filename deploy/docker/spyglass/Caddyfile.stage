{
	admin off
	auto_https off
}

(web_routes) {
	@privacy_api path /api/v1/privacy /api/v1/privacy/* /api/v1/analytics/events
	handle @privacy_api {
		reverse_proxy account-api:8080
	}
	handle {
		reverse_proxy website:3000
	}
}

(app_routes) {
	# Related Origin Requests allow an app passkey at the isolated staff origin.
	# The operations API still validates the exact ops origin and staff role.
	handle /.well-known/webauthn {
		header Content-Type application/json
		respond `{"origins":["https://ops.stage.infiniteocean.net"]}` 200
	}
	@cell_api path_regexp cell_api ^/api/v1/accounts/[^/]+/(context|attention(?:/.*)?|knowledge(?:/.*)?|work-items(?:/.*)?|agent-(?:boardrooms|conversations|runs)(?:/.*)?|schedules(?:/.*)?|finance(?:/.*)?|integrations(?:/.*)?|baseline-assessments(?:/.*)?|marketing(?:/.*)?)$
	handle @cell_api {
		reverse_proxy app-router:8080
	}
	@vue {
		method GET HEAD
		path /app /app/setup /app/your-turn /app/your-turn/* /app/work /app/work/* /app/knowledge /app/knowledge/* /app/baseline /app/baseline/* /app/agents /app/agents/* /app/schedules /app/schedules/* /app/finance /app/finance/* /app/integrations /app/integrations/* /app/marketing /app/marketing/* /app/account /app/billing /app/security /app/account-exports /app/account-closures /app/privacy /app/checkout /app/affiliate /ui-assets/*
	}
	handle @vue {
		reverse_proxy private-ui:8080
	}
	handle {
		reverse_proxy account-api:8080
	}
}

http://stage.infiniteocean.net {
	import web_routes
}

http://app.stage.infiniteocean.net {
	import app_routes
}

http://mcp.stage.infiniteocean.net {
	reverse_proxy mcp-gateway:8080
}

http://ops.stage.infiniteocean.net {
	@operations_api path /api/operations/*
	handle @operations_api {
		reverse_proxy operations-api:8080
	}
	handle {
		reverse_proxy operations-ui:8080
	}
}
