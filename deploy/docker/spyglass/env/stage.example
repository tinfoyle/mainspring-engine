# Copy to a root-readable file outside the checkout and replace every REPLACE value.
# Image digests come from a reviewed deploy/releases/<version>.env file.
SPYGLASS_ENVIRONMENT=stage
SPYGLASS_PROCESS_ENV=stage
SPYGLASS_PUBLIC_ORIGIN=https://stage.infiniteocean.net
SPYGLASS_APP_ORIGIN=https://app.stage.infiniteocean.net
SPYGLASS_PASSKEY_RP_ID=app.stage.infiniteocean.net
SPYGLASS_CELL_A_ROUTE_ORIGIN=https://app-api-a:8443
SPYGLASS_CELL_B_ROUTE_ORIGIN=https://app-api-b:8443
SPYGLASS_WORK_ADMISSION_ORIGIN=https://admission-api:8443
SPYGLASS_HOST_EDGE_NETWORK=infiniteocean_public
SPYGLASS_STAGE_SECRETS_DIRECTORY=/opt/spyglass-stage/secrets
SPYGLASS_OBJECT_STORE_ENDPOINT=object-store:9000
SPYGLASS_OBJECT_STORE_BUCKET=spyglass-documents
SPYGLASS_OBJECT_STORE_ACCESS_KEY=REPLACE
SPYGLASS_OBJECT_STORE_SECRET_KEY=REPLACE
SPYGLASS_OBJECT_STORE_APP_ACCESS_KEY=REPLACE
SPYGLASS_OBJECT_STORE_APP_SECRET_KEY=REPLACE
SPYGLASS_OBJECT_STORE_WORKER_ACCESS_KEY=REPLACE
SPYGLASS_OBJECT_STORE_WORKER_SECRET_KEY=REPLACE
SPYGLASS_OBJECT_STORE_MIGRATION_ACCESS_KEY=REPLACE
SPYGLASS_OBJECT_STORE_MIGRATION_SECRET_KEY=REPLACE
SPYGLASS_OBJECT_STORE_KMS_SECRET_KEY=REPLACE_KEY_NAME_COLON_BASE64_32_BYTES
SPYGLASS_OBJECT_STORE_SECURE=false
SPYGLASS_OBJECT_STORE_SERVER_SIDE_ENCRYPTION=true
SPYGLASS_CLAMAV_DISABLE_UPDATES=false

# Database owner and per-process passwords/URLs are separate random values.
SPYGLASS_GLOBAL_DATABASE_PASSWORD=REPLACE
