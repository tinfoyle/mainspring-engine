# Import inside each Spyglass Stage site with a static filename argument.
# Only the User-Agent header is retained; other headers and URLs are excluded.
(spyglass_stage_access) {
  log_append user_agent {http.request.header.User-Agent}
  log {
    output file /data/spyglass-access/{args[0]}.log {
      mode 0640
      roll_size 10MiB
      roll_keep 7
      roll_keep_for 168h
    }
    format filter {
      wrap json
      fields {
        request>headers delete
        request>uri delete
        request>tls delete
        resp_headers delete
        user_id delete
      }
    }
  }
}
